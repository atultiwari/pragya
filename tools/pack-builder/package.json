{
  "name": "@pragya/pack-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pack-builder": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "content": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@pragya/content": "workspace:^",
    "@pragya/db": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
