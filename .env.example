# Copy to .env and fill in. Never commit .env.
MYSQL_DATABASE=pragya
MYSQL_USER=pragya
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MEILI_MASTER_KEY=change-me-meili

# Used by packages/db (migrations, integration tests) and apps/api
DATABASE_URL=mysql://pragya:change-me@localhost:3306/pragya
# Integration tests use their own database (created by docker/mysql-init on a fresh volume)
TEST_DATABASE_URL=mysql://pragya:change-me@localhost:3306/pragya_test

# apps/api
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Auth (Better Auth, served by apps/api at /api/auth)
# Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Optional: enable Google sign-in by setting both
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Always true in production; set true locally to test the verification flow
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Local only: log verification links and OTPs instead of sending them (refused in production)
AUTH_DEV_SENDERS=true

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
# Absolute path of the folder pack-builder import copies figures into and the API serves from
# (/content/<course>/<file>, access-checked). Defaults to <repo>/var/content for the importer.
CONTENT_ASSETS_DIR=/absolute/path/to/pragya/var/content
